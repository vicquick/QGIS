class QgsLayoutItemGroup : QgsLayoutItem
{
%Docstring(signature="appended")
A container for grouping several :py:class:`QgsLayoutItems`.
%End

%TypeHeaderCode
#include "qgslayoutitemgroup.h"
%End
  public:
    explicit QgsLayoutItemGroup( QgsLayout *layout );
%Docstring
Constructor for QgsLayoutItemGroup, belonging to the specified
``layout``.
%End
    ~QgsLayoutItemGroup();

    virtual void cleanup();


    virtual int type() const;

    virtual QString displayName() const;


    static QgsLayoutItemGroup *create( QgsLayout *layout ) /Factory/;
%Docstring
Returns a new group item for the specified ``layout``.

The caller takes responsibility for deleting the returned object.
%End

    void addItem( QgsLayoutItem *item /Transfer/ );
%Docstring
Adds an ``item`` to the group. Ownership of the item is transferred to
the group.
%End

    void insertItem( QgsLayoutItem *item /Transfer/, int index );
%Docstring
Inserts an ``item`` into the group at position ``index`` of the group's
local z-stack (0 = topmost). Ownership of the item is transferred to the
group.

An ``index`` outside the current range appends the item to the bottom of
the stack. If ``item`` is already a member of the group it is moved to
``index`` instead of being added a second time.

.. seealso:: :py:func:`addItem`
%End

    bool removeItem( QgsLayoutItem *item );
%Docstring
Removes a single ``item`` from the group (but does not delete it). The
item remains in the scene but is no longer grouped.

Returns ``True`` if ``item`` was a member of the group.

.. seealso:: :py:func:`removeItems`
%End

    void removeItems();
%Docstring
Removes all items from the group (but does not delete them). Items
remain in the scene but are no longer grouped together
%End

    QList<QgsLayoutItem *> items() const;
%Docstring
Returns a list of items contained by the group, in local z-order (index
0 = topmost within the group, last index = bottommost).
%End

    bool reorderItemUp( QgsLayoutItem *item );
%Docstring
Moves an ``item`` one step toward the top of the group's local z-stack.
Returns ``True`` if ``item`` was moved.
%End

    bool reorderItemDown( QgsLayoutItem *item );
%Docstring
Moves an ``item`` one step toward the bottom of the group's local
z-stack. Returns ``True`` if ``item`` was moved.
%End

    bool reorderItemToTop( QgsLayoutItem *item );
%Docstring
Moves an ``item`` to the top of the group's local z-stack. Returns
``True`` if ``item`` was moved.
%End

    bool reorderItemToBottom( QgsLayoutItem *item );
%Docstring
Moves an ``item`` to the bottom of the group's local z-stack. Returns
``True`` if ``item`` was moved.
%End

    virtual void setVisibility( bool visible );


    virtual void attemptMove( const QgsLayoutPoint &point, bool useReferencePoint = true, bool includesFrame = false, int page = -1 );

    virtual void attemptResize( const QgsLayoutSize &size, bool includesFrame = false );


    virtual void paint( QPainter *painter, const QStyleOptionGraphicsItem *itemStyle, QWidget *pWidget );


    virtual void finalizeRestoreFromXml();

    virtual ExportLayerBehavior exportLayerBehavior() const;


    virtual QRectF rectWithFrame() const;


  protected:
    virtual void draw( QgsLayoutItemRenderContext &context );

    virtual bool writePropertiesToElement( QDomElement &parentElement, QDomDocument &document, const QgsReadWriteContext &context ) const;

    virtual bool readPropertiesFromElement( const QDomElement &itemElement, const QDomDocument &document, const QgsReadWriteContext &context );


};

